    {
      "name": "POST",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Статус должен быть 200\", function() {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Ответ содержит text и id\", function() {\r",
              "    const data = pm.response.json();\r",
              "    pm.expect(data).to.have.property(\"text\");\r",
              "    pm.expect(data).to.have.property(\"id\");\r",
              "    pm.expect(data.text).to.include(\"Kirill\");\r",
              "});\r",
              "\r",
              "const data = pm.response.json();\r",
              "if (data && data.id !== undefined) {\r",
              "    pm.collectionVariables.set(\"user_id\", pm.response.json().id);\r",
              "    console.log(\"user_id сохранён:\", pm.globals.get(\"user_id\"));\r",
              "} else {\r",
              "    console.warn(\"Поле id не найдено в ответе\");\r",
              "};"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
