  "item": [
    {
      "name": "GET_without_params",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Статус ответа должен быть 200\", function() {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Поле 'text' существует и не является пустым\", function() {\r",
              "    const data = pm.response.json();\r",
              "    pm.expect(data).to.have.property(\"text\");\r",
              "    pm.expect(data.text).to.be.a(\"string\");\r",
              "    pm.expect(data.text.length).to.be.greaterThan(0);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "packages": {},
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/greeting",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "greeting"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET_query",
