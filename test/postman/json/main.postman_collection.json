              "});\r",
              "\r",
              "pm.test(\"Возвращены данные пользователя\", function() {\r",
              "    const data = pm.response.json();\r",
              "    pm.expect(data).to.have.property(\"name\");\r",
              "    pm.expect(data).to.have.property(\"surname\");\r",
              "    pm.expect(data.name).to.equal(\"Kirill\");\r",
              "    pm.expect(data.surname).to.equal(\"Kozlov\");\r",
              "});"
            ],
            "type": "text/javascript",
